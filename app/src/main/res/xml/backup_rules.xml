<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Backup is disabled in the manifest (allowBackup="false"); these rules also
     exclude all app data in case backup is ever re-enabled by mistake. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
